import Sequelize, { Model } from 'sequelize';
import sha256 from 'js-sha256';
import bcrypt from 'bcrypt';

class User extends Model {
  static init(sequelize) {
    super.init(
      {
        idacesso: {
          type: Sequelize.STRING,
          primaryKey: true,
        },
        login: Sequelize.STRING,
        email: Sequelize.STRING,
        nome: Sequelize.STRING,
        ativo: Sequelize.BOOLEAN,
        sha: Sequelize.STRING,
        cli_grupos: Sequelize.STRING,
      },
      {
        sequelize,
        tableName: 'sis_acesso',
      }
    );

    return this;
  }

  checkPassword(password) {
    // Try SHA256 first (backward compatibility with old passwords)
    const sha256Hash = sha256(password);
    if (sha256Hash === this.sha) {
      return true;
    }
    
    // Try bcrypt if SHA256 fails (new secure passwords)
    try {
      return bcrypt.compareSync(password, this.sha);
    } catch (error) {
      // If bcrypt fails, password is invalid
      return false;
    }
  }

  // Helper method to hash new passwords with bcrypt
  static hashPassword(password) {
    return bcrypt.hashSync(password, 10);
  }
}

export default User;
