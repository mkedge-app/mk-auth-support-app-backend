# ===========================================
# MK-Edge Backend - Environment Variables
# ===========================================

# Application
NODE_ENV=production
APP_PORT=3333

# JWT Authentication
JWT_SECRET=change-this-super-secret-key-min-32-chars-please
JWT_EXPIRES_IN=7d
AUTH_SECRET=change-this-super-secret-key-min-32-chars-please
AUTH_EXPIRESIN=7d

# MongoDB (Tenants, Subscriptions, Invoices)
MONGODB_URL=mongodb://mongo:27017/mkedgetenants
MONGODB_USER=root
MONGODB_PASSWORD=mk-edge-mongo-2024-secure

# MySQL/MariaDB (Legacy - multi-tenant via MongoDB)
DATABASE_DIALECT=mysql
DATABASE_HOST=localhost
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_NAME=mkradius

# OneSignal Push Notifications
APP_ID_PUSH_NOTIFICATION=your-onesignal-app-id-here

# ===========================================
# EFI (Gerencianet) - Pagamentos PIX/Boleto
# ===========================================
EFI_CLIENT_ID=Client_Id_your_efi_client_id
EFI_CLIENT_SECRET=Client_Secret_your_efi_secret
EFI_SANDBOX=true
EFI_CERT_PATH=./cert/producao.p12
EFI_PIX_KEY=your-pix-key
EFI_CERTIFICATE_PATH=./cert/producao.p12

# ===========================================
# Z-API - WhatsApp Business
# ===========================================
ZAPI_URL=https://api.z-api.io
ZAPI_INSTANCE=your-instance-id
ZAPI_TOKEN=your-zapi-token
ZAPI_CLIENT_TOKEN=your-client-token

# ===========================================
# Notificações
# ===========================================
NOTIFICATIONS_WHATSAPP_ENABLED=false
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_DIAS_AVISO=7,3,1

